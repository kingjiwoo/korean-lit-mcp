# Public MCP: users connect using only the /mcp URL.
# Local default; leave unset on Vercel to use its generated deployment domains.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=
MCP_HOST=127.0.0.1
PORT=8000
# Optional external catalogue API key; never sent to teachers.
NL_API_KEY=
# Optional directory of reviewed texts and their manifests.
WORKS_DIR=data/works

# Optional public ITKC search endpoint; no authentication key required.
ITKC_API_URL=
